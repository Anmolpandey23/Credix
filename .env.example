# ==========================================
# Credix Environment Configuration Template
# ==========================================
# Copy this file to .env and customize as needed:
#   cp .env.example .env

# Optional Anthropic Claude API configuration for external live web research
# If left blank, Credix will use local RSS news feeds for market intelligence
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Optional: Streamlit settings (or configure via .streamlit/config.toml)
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_HEADLESS=true
